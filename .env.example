# Copy to .env — all variables are optional for the local demo.
# Vite only exposes variables prefixed with VITE_ to the browser.

# App title shown in the header (default: "Referral Coordination — Demo")
VITE_APP_TITLE=

# Set to "false" to hide the "Reset demo" button (default: true)
VITE_ENABLE_DEMO_RESET=true
